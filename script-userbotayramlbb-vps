# ============== LOOP AUTO-SHARE ==============
async def auto_share_loop(ubot, user_id_str):
    """Loop pengiriman pesan otomatis"""
    while True:
        try:
            as_data = data["auto_share"].get(user_id_str, {})
            if not as_data.get("aktif"):
                break
            
            pesan = as_data.get("pesan", "")
            jeda = as_data.get("jeda", 60)
            blacklist = data["blacklist"].get(user_id_str, [])
            
            if not pesan:
                await asyncio.sleep(jeda)
                continue
            
            # Dapatkan semua dialog/grup
            async for dialog in ubot.get_dialogs():
                chat_id = str(dialog.chat.id)
                if chat_id in blacklist:
                    continue
                
                try:
                    await ubot.send_message(dialog.chat.id, pesan)
                    await asyncio.sleep(2)  # Jeda antar chat
                except Exception:
                    pass
            
            await asyncio.sleep(jeda)
        except asyncio.CancelledError:
            break
        except Exception:
            await asyncio.sleep(10)

