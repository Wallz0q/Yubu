async def create_userbot(user_id, phone, session_string=None):
    """Membuat instance userbot baru untuk pengguna"""
    session_name = f"ubot_{user_id}"
    
    if session_string:
        ubot = Client(
            session_name,
            api_id=API_ID,
            api_hash=API_HASH,
            session_string=session_string
        )
    else:
        ubot = Client(
            session_name,
            api_id=API_ID,
            api_hash=API_HASH,
            phone_number=phone
        )
    
    return ubot

