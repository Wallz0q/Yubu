    @ubot.on_message(filters.text & filters.me)
    async def game_handler(client, message: PyroMessage):
        game_data = data["games"].get(uid, {})
        if not game_data or game_data.get("game") != "tebakkata":
            return
        
        tebakan = message.text.upper().strip()
        kata = game_data["kata"]
        tampil = game_data["tampil"]
        kesempatan = game_data["kesempatan"]
        sudah_tebak = game_data["sudah_tebak"]
        
        if tebakan in sudah_tebak:
            await message.edit("⚠️ Sudah ditebak! Coba huruf lain.")
            return
        
        sudah_tebak.append(tebakan)
        
        if len(tebakan) == 1:
            # Tebak huruf
            if tebakan in kata:
                for i, huruf in enumerate(kata):
                    if huruf == tebakan:
                        tampil[i] = tebakan
                
                if "_" not in tampil:
                    del data["games"][uid]
                    save_data(data)
                    await message.edit(f"🎉 **MENANG!**\n\nKata: {kata}")
                    return
            else:
                kesempatan -= 1
                if kesempatan <= 0:
                    del data["games"][uid]
                    save_data(data)
                    await message.edit(f"💀 **KALAH!**\n\nKata yang benar: {kata}")
                    return
        else:
            # Tebak kata lengkap
            if tebakan == kata:
                del data["games"][uid]
                save_data(data)
                await message.edit(f"🎉 **MENANG!**\n\nKata: {kata}")
                return
            else:
                kesempatan -= 1
                if kesempatan <= 0:
                    del data["games"][uid]
                    save_data(data)
                    await message.edit(f"💀 **KALAH!**\n\nKata yang benar: {kata}")
                    return
        
        game_data["tampil"] = tampil
        game_data["kesempatan"] = kesempatan
