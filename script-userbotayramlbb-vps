    @ubot.on_message(filters.command("meta", prefixes=".") & filters.me)
    async def ubot_meta(client, message: PyroMessage):
        prompt = message.text[len(".meta "):].strip()
        if not prompt:
            await message.edit("❌ Format: `.meta <teks>`")
            return
        
        await message.edit("🧠 Meta AI sedang berpikir...")
