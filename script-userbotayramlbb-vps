@dp.message_handler(content_types=['text'])
async def handle_text(message: types.Message):
    """Menangani input verifikasi userbot"""
    user_id = str(message.from_user.id)
    session = data["sessions"].get(user_id, {})
    
    if not session:
        return
    
    step = session.get("step")
    
    if step == "waiting_phone":
        phone = message.text.strip()
        if not phone.startswith("+"):
            await message.reply("❌ Nomor harus diawali dengan kode negara!\nContoh: `+6281234567890`", parse_mode="Markdown")
            return
        
        # Membuat userbot dan mengirim kode
        try:
            ubot = await create_userbot(int(user_id), phone)
            await ubot.connect()
            sent_code = await ubot.send_code(phone)
            
            data["sessions"][user_id] = {
                "step": "waiting_code",
                "phone": phone,
                "phone_code_hash": sent_code.phone_code_hash,
                "ubot_instance": str(id(ubot))
            }
            userbots[user_id] = ubot
            save_data(data)
            
            await message.reply(
                "✅ Kode verifikasi telah dikirim!\n\n"
                "Silakan kirimkan kode yang Anda terima dari Telegram.\n"
                "Format: `12345` (pisahkan dengan spasi jika ada: `1 2 3 4 5`)",
                parse_mode="Markdown"
            )
        except Exception as e:
            await message.reply(f"❌ Gagal mengirim kode: `{str(e)}`", parse_mode="Markdown")
            data["sessions"].pop(user_id, None)
            save_data(data)
    
    elif step == "waiting_code":
        code = message.text.strip().replace(" ", "")
        phone = session.get("phone")
        phone_code_hash = session.get("phone_code_hash")
        ubot = userbots.get(user_id)
        
        if not ubot:
            await message.reply("❌ Sesi expired, silakan ulangi!")
            data["sessions"].pop(user_id, None)
            save_data(data)
            return
        
        try:
            await ubot.sign_in(phone, phone_code_hash, code)
            
            # Cek apakah butuh PIN 2FA
            session_string = await ubot.export_session_string()
            
            data["allowed_users"][user_id]["userbot_aktif"] = True
            data["allowed_users"][user_id]["session_string"] = session_string
            data["allowed_users"][user_id]["phone"] = phone
            data["sessions"].pop(user_id, None)
            save_data(data)
            
            # Daftarkan handler userbot dan jalankan
            await register_userbot_handlers(ubot, user_id)
            asyncio.create_task(ubot.start())
            
            await message.reply(
                "✅ **Userbot Berhasil Diaktifkan!**\n\n"
                f"📱 Nomor: {phone}\n"
                "🎯 Semua fitur siap digunakan!\n\n"
                "Ketik /start untuk kembali ke menu."
            )
            
        except Exception as e:
            if "2FA" in str(e) or "password" in str(e).lower():
                data["sessions"][user_id]["step"] = "waiting_pin"
                save_data(data)
                await message.reply("🔐 Akun Anda menggunakan 2FA!\nSilakan kirimkan PIN Anda:")
            else:
                await message.reply(f"❌ Gagal verifikasi: `{str(e)}`", parse_mode="Markdown")
                data["sessions"].pop(user_id, None)
                save_data(data)
    
    elif step == "waiting_pin":
        pin = message.text.strip()
        phone = session.get("phone")
        phone_code_hash = session.get("phone_code_hash")
        ubot = userbots.get(user_id)
        
        try:
            await ubot.check_password(pin)
            session_string = await ubot.export_session_string()
            
            data["allowed_users"][user_id]["userbot_aktif"] = True
            data["allowed_users"][user_id]["session_string"] = session_string
            data["allowed_users"][user_id]["phone"] = phone
            data["sessions"].pop(user_id, None)
            save_data(data)
            
            await register_userbot_handlers(ubot, user_id)
            asyncio.create_task(ubot.start())
            
            await message.reply(
                "✅ **Userbot Berhasil Diaktifkan!**\n\n"
                f"📱 Nomor: {phone}\n"
                "🎯 Semua fitur siap digunakan!\n\n"
                "Ketik /start untuk kembali ke menu."
            )
        except Exception as e:
            await message.reply(f"❌ PIN salah: `{str(e)}`", parse_mode="Markdown")

# ============== FUNGSI DAFTARKAN HANDLER USERBOT ==============
async def register_userbot_handlers(ubot, user_id_str):
    """Mendaftarkan semua handler fitur userbot"""
    uid = user_id_str
    
    # ==================== FITUR AUTO-SHARE ====================
    @ubot.on_message(filters.command("setpesan", prefixes=".") & filters.me)
    async def ubot_setpesan(client, message: PyroMessage):
        text = message.text[len(".setpesan "):].strip()
        if not text:
            await message.edit("❌ Format: `.setpesan <teks>`")
            return
        
        if uid not in data["auto_share"]:
            data["auto_share"][uid] = {}
        data["auto_share"][uid]["pesan"] = text
        save_data(data)
        await message.edit(f"✅ Pesan otomatis diatur!\n\n📝 Pesan: {text[:100]}")
    
    @ubot.on_message(filters.command("setjeda", prefixes=".") & filters.me)
    async def ubot_setjeda(client, message: PyroMessage):
        try:
            detik = int(message.text.split()[1])
            if uid not in data["auto_share"]:
                data["auto_share"][uid] = {}
            data["auto_share"][uid]["jeda"] = detik
            save_data(data)
            await message.edit(f"✅ Jeda waktu diatur: {detik} detik")
        except:
            await message.edit("❌ Format: `.setjeda <detik>`")
    
    @ubot.on_message(filters.command("autoshare", prefixes=".") & filters.me)
    async def ubot_autoshare(client, message: PyroMessage):
        args = message.text.split()
        if len(args) < 2:
            await message.edit("❌ Format: `.autoshare on` atau `.autoshare off`")
            return
        
        status = args[1].lower()
        if uid not in data["auto_share"]:
            data["auto_share"][uid] = {}
        
        if status == "on":
            data["auto_share"][uid]["aktif"] = True
            save_data(data)
            
            # Jalankan auto-share task
            if uid in auto_share_tasks:
                auto_share_tasks[uid].cancel()
            task = asyncio.create_task(auto_share_loop(ubot, uid))
            auto_share_tasks[uid] = task
            
            await message.edit("🟢 Auto-Share diaktifkan!")
        
        elif status == "off":
            data["auto_share"][uid]["aktif"] = False
            save_data(data)
            
            if uid in auto_share_tasks:
                auto_share_tasks[uid].cancel()
                del auto_share_tasks[uid]
            
            await message.edit("🔴 Auto-Share dimatikan!")
        else:
            await message.edit("❌ Pilih `on` atau `off`")
    
    @ubot.on_message(filters.command("addbl", prefixes=".") & filters.me)
    async def ubot_addbl(client, message: PyroMessage):
        chat_id = str(message.chat.id)
        if uid not in data["blacklist"]:
            data["blacklist"][uid] = []
        
        if chat_id in data["blacklist"][uid]:
            data["blacklist"][uid].remove(chat_id)
            save_data(data)
            await message.edit("✅ Chat dihapus dari blacklist!")
        else:
            data["blacklist"][uid].append(chat_id)
            save_data(data)
            await message.edit("✅ Chat ditambahkan ke blacklist!")
    
    # ==================== FITUR AI ====================
    @ubot.on_message(filters.command("gemini", prefixes=".") & filters.me)
    async def ubot_gemini(client, message: PyroMessage):
        prompt = message.text[len(".gemini "):].strip()
        if not prompt:
            await message.edit("❌ Format: `.gemini <teks>`")
            return
        
        await message.edit("🧠 Gemini sedang berpikir...")
        try:
            response = await ai_gemini(prompt)
            await message.edit(f"🤖 **Gemini:**\n\n{response[:4000]}", parse_mode="Markdown")
        except Exception as e:
            await message.edit(f"❌ Error: {str(e)}")
    
    @ubot.on_message(filters.command("cici", prefixes=".") & filters.me)
    async def ubot_cici(client, message: PyroMessage):
        prompt = message.text[len(".cici "):].strip()
        if not prompt:
            await message.edit("❌ Format: `.cici <teks>`")
            return
        
        await message.edit("🧠 Cici sedang berpikir...")
        try:
            response = await ai_cici(prompt)
            await message.edit(f"🤖 **Cici:**\n\n{response[:4000]}", parse_mode="Markdown")
        except Exception as e:
            await message.edit(f"❌ Error: {str(e)}")
    
    @ubot.on_message(filters.command("gpt", prefixes=".") & filters.me)
    async def ubot_gpt(client, message: PyroMessage):
        prompt = message.text[len(".gpt "):].strip()
        if not prompt:
            await message.edit("❌ Format: `.gpt <teks>`")
