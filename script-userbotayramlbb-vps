async def cek_roblox(username):
    """Cek akun Roblox"""
    try:
        async with aiohttp.ClientSession() as session:
            # Cari user ID
            url = f"https://users.roblox.com/v1/users/search?keyword={username}"
            async with session.get(url) as resp:
                data = await resp.json()
                if data.get("data"):
                    user = data["data"][0]
                    user_id = user["id"]
                    
                    # Get detail
                    url2 = f"https://users.roblox.com/v1/users/{user_id}"
                    async with session.get(url2) as resp2:
                        detail = await resp2.json()
                    
                    return {
                        "username": detail.get("name", username),
                        "id": user_id,
                        "created": detail.get("created", "N/A")[:10],
                        "friends": "Lihat di profil",
                        "followers": "Lihat di profil",
                        "following": "Lihat di profil",
                        "status": detail.get("displayName", "N/A")
                    }
    except:
        pass
    return {"username": username, "id": "N/A", "created": "N/A", "friends": "N/A", "followers": "N/A", "following": "N/A", "status": "Data tidak tersedia"}

