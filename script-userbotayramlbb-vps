# ============== FUNGSI CANVAS BRAT ==============
async def buat_brat_image(teks):
    """Membuat gambar gaya Brat"""
    try:
        from PIL import Image, ImageDraw, ImageFont
        
        # Buat background gradien sederhana
        width, height = 800, 800
        img = Image.new('RGB', (width, height), color='#FF69B4')
        draw = ImageDraw.Draw(img)
        
        # Tambah teks
        try:
            font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 60)
        except:
            font = ImageFont.load_default()
        
        # Hitung posisi tengah
        bbox = draw.textbbox((0, 0), teks, font=font)
        text_width = bbox[2] - bbox[0]
        text_height = bbox[3] - bbox[1]
        
        x = (width - text_width) // 2
        y = (height - text_height) // 2
        
        # Shadow
        draw.text((x+5, y+5), teks, fill='black', font=font)
        # Teks utama
        draw.text((x, y), teks, fill='white', font=font)
        
        filename = f"brat_{int(time.time())}.jpg"
        img.save(filename)
        return filename
    except:
        return None

async def buat_brat_video(teks):
    """Membuat video Brat sederhana"""
    # Buat gambar dulu lalu jadikan video sederhana
    img_file = await buat_brat_image(teks)
    if img_file:
        # Ubah ekstensi jadi mp4 (simulasi)
        import shutil
        video_file = f"bratvid_{int(time.time())}.mp4"
        try:
            # Gunakan ffmpeg jika tersedia
            os.system(f"ffmpeg -loop 1 -i {img_file} -c:v libx264 -t 3 -pix_fmt yuv420p {video_file} -y 2>/dev/null")
            if os.path.exists(video_file):
                return video_file
        except:
            pass
        return img_file
    return None

